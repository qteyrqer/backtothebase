backtothebase.console.help=可用子命令：add, remove, list, account, test, status, cancel, reload
backtothebase.console.help_add=  bttb add <玩家> <x> <y> <z> [基地编号]  添加/更新活板门坐标
backtothebase.console.help_remove=  bttb remove <玩家> [基地编号]  移除一个基地或整个玩家
backtothebase.console.help_list=  bttb list [玩家]  查看白名单
backtothebase.console.help_account=  bttb account <机器人账号>  设置机器人账号
backtothebase.console.help_test=  bttb test <玩家> [基地编号]  在控制台模拟一次返回请求
backtothebase.console.help_status=  bttb status / cancel / reload  查看状态、取消请求、重载配置

