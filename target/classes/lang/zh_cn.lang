# backtothebase - Simplified Chinese (default)
backtothebase.command.description=让白名单玩家请求机器人返回基地并操作活板门
backtothebase.command.usage=/backtothebase <add|remove|list|account|test|status|cancel|reload>

backtothebase.console.added=已添加白名单：%s 基地 %s -> (%s, %s, %s)
